# ============================================================
# 复制这个文件为 .env，填入你自己的密钥
#   cp .env.example .env      (macOS / Linux)
#   copy .env.example .env    (Windows)
#
# .env 已经在 .gitignore 里，永远不会被提交。
# 但请记住：一旦推过又删掉，历史记录里仍然留着，只能换密钥。
# ============================================================

# Tushare token
# 注册：https://tushare.pro/register
# 登录后：个人主页 → 接口 TOKEN → 复制
TUSHARE_TOKEN=


# ============================================================
# 以下暂时用不到，等用到那一步再填
# ============================================================

# 大模型 API（2027年1月做文本分析时用）
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# 数据区间（可选，代码里默认 20180101 – 20261231）
# START_DATE=20180101
# END_DATE=20261231
