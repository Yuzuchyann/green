# ============================================================
# 密钥与环境变量 —— 最重要，绝对不要提交
# Tushare token、大模型 API key 都放 .env，一旦泄露会被盗用
# ============================================================
.env
.env.*
# 下面这行必须单独占一行：gitignore 不支持行尾注释，
# 写成「!.env.example  # 说明」会让整条规则失效
!.env.example
*.key
secrets.json
config_local.py
credentials.json

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.ipynb_checkpoints/
.venv/
venv/
env/

# ============================================================
# 数据 —— 体积大且可再生，不入库
# 原始报告几百 MB，解析结果几十 MB，推上去仓库会臃肿到没法用
# 目录本身保留（靠 .gitkeep），内容忽略
# ============================================================
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.pdf
*.db
*.sqlite
*.sqlite3
*.parquet

# ============================================================
# 编辑器与系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
